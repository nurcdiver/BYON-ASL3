; Magic PTT BYON Desktop peer — ADDITIVE (generated by BYON-ASL3 install)
; Rollback: remove #include from pjsip.conf and delete this file.

[${BYON_SIP_USER}]
type=endpoint
transport=transport-udp
context=magicptt-byon
disallow=all
allow=ulaw
allow=alaw
auth=${BYON_SIP_USER}
aors=${BYON_SIP_USER}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[${BYON_SIP_USER}]
type=auth
auth_type=userpass
username=${BYON_SIP_USER}
password=${BYON_SIP_PASS}

[${BYON_SIP_USER}]
type=aor
max_contacts=2
remove_existing=yes

[${BYON_SIP_USER}-identify]
type=identify
endpoint=${BYON_SIP_USER}
match=${BYON_LAN}
